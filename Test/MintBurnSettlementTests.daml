      assertMsg "allocation burn change mismatch" (change.owner == ctx.alice && change.amount == 500.0)
    _ -> abort "expected one allocation burn change holding"

burnRejectsWrongUsdcxAllocationTest : Script ()
burnRejectsWrongUsdcxAllocationTest = script do
  ctx <- setup ()
  offerCid <- createOffer ctx
  burnReqCid <- createBurnRequest ctx offerCid
