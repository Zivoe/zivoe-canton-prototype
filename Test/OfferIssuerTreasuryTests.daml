module Test.OfferIssuerTreasuryTests where

import Daml.Script

import Test.Util
import Zivoe.IssuerRole
import Zivoe.Treasury
import Zivoe.Types

createIssuerRole : TestContext -> Script (ContractId IssuerRole)
createIssuerRole ctx =
  submit ctx.issuer do
    createCmd IssuerRole with
      config = ctx.config
      navPrice = ctx.price
      requesters = [ctx.alice, ctx.bob]

issuerRoleCreatesRequestsTest : Script ()
issuerRoleCreatesRequestsTest = script do
  ctx <- setup ()
  issuerRoleCid <- createIssuerRole ctx

  mintReqCid <- submit ctx.alice do
    exerciseCmd issuerRoleCid RequestMint with
      user = ctx.alice
      usdcxAmount = 1050.0
      minTokensOut = 999.0
      requestNonce = "issuer-role-mint"

  mintReq <- queryContractId ctx.alice mintReqCid >>= expectSome "expected mint request"
  assertMsg "mint request amount mismatch" (mintReq.usdcxAmount == 1050.0)

  burnReqCid <- submit ctx.alice do
    exerciseCmd issuerRoleCid RequestBurn with
      user = ctx.alice
      tokenAmount = 500.0
      minUsdcxOut = 524.0
      requestNonce = "issuer-role-burn"

  burnReq <- queryContractId ctx.alice burnReqCid >>= expectSome "expected burn request"
  assertMsg "burn request amount mismatch" (burnReq.tokenAmount == 500.0)

issuerRoleRejectsBadSlippageTest : Script ()
issuerRoleRejectsBadSlippageTest = script do
  ctx <- setup ()
  issuerRoleCid <- createIssuerRole ctx

  submitMustFail ctx.alice do
    exerciseCmd issuerRoleCid RequestMint with
      user = ctx.alice
      usdcxAmount = 1050.0
      minTokensOut = 1001.0
      requestNonce = "bad-mint-slippage"

  submitMustFail ctx.alice do
    exerciseCmd issuerRoleCid RequestBurn with
      user = ctx.alice
      tokenAmount = 500.0
      minUsdcxOut = 526.0
      requestNonce = "bad-burn-slippage"

issuerRoleValidationTest : Script ()
issuerRoleValidationTest = script do
  ctx <- setup ()
  issuerRoleCid <- createIssuerRole ctx

  submitMustFail ctx.issuer do
    exerciseCmd issuerRoleCid UpdatePrice with
      newPrice = ctx.price with
        currency = "USD"

  submitMustFail ctx.issuer do
    exerciseCmd issuerRoleCid UpdatePrice with
      newPrice = ctx.price with
        value = 0.0

  updatedCid <- submit ctx.issuer do
    exerciseCmd issuerRoleCid UpdatePrice with
      newPrice = ctx.price with
        value = 1.1
        priceId = "price-002"

  updated <- queryContractId ctx.issuer updatedCid >>= expectSome "expected updated issuer role"
  assertMsg "issuer role config mismatch" (updated.config == ctx.config)
  assertMsg "issuer role price mismatch" (updated.navPrice.value == 1.1)

treasuryMovementTest : Script ()
treasuryMovementTest = script do
  ctx <- setup ()

  treasuryCid <- submit ctx.treasury do
    createCmd TreasuryAccount with
      config = ctx.config

  movementCid <- submit (actAs [ctx.treasuryAdmin, ctx.treasury]) do
    exerciseCmd treasuryCid PullForOffchainTokenization with
      action = TreasuryAction with
        amount = 100.0
        recipient = ctx.treasuryAdmin
        reason = "test pull"
        movementRef = "pull-001"

  movement <- queryContractId ctx.treasury movementCid >>= expectSome "expected treasury movement"
  assertMsg "treasury movement amount mismatch" (movement.amount == 100.0)
  assertMsg "treasury movement reason mismatch" (movement.reason == "test pull")
  assertMsg "treasury movement ref mismatch" (movement.movementRef == "pull-001")

  submitMustFail (actAs [ctx.treasuryAdmin, ctx.treasury]) do
    exerciseCmd treasuryCid PullForOffchainTokenization with
      action = TreasuryAction with
        amount = 0.0
        recipient = ctx.treasuryAdmin
        reason = "invalid pull"
        movementRef = "pull-002"

treasuryMovementWithTransferTest : Script ()
treasuryMovementWithTransferTest = script do
  ctx <- setup ()

  treasuryCid <- submit ctx.treasury do
    createCmd TreasuryAccount with
      config = ctx.config

  let action = TreasuryAction with
        amount = 100.0
        recipient = ctx.treasuryAdmin
        reason = "test transfer pull"
        movementRef = "pull-transfer-001"

  usdcxCid <- createUsdcxToken ctx ctx.treasury action.amount
  transferResult <- instructTransferWithExtraArgs ctx.treasury usdcxCid action.recipient action.amount (requestExtraArgs action.movementRef)
  transferInstructionCid <- expectPendingTransfer transferResult

  movementCid <- submit (actAs [ctx.treasuryAdmin, ctx.treasury]) do
    exerciseCmd treasuryCid PullForOffchainTokenizationWithTransfer with
      action
      usdcxTransferInstructionCid = transferInstructionCid
      extraArgs = defaultExtraArgs

  movement <- queryContractId ctx.treasury movementCid >>= expectSome "expected transfer-backed treasury movement"
  assertMsg "transfer treasury movement amount mismatch" (movement.amount == action.amount)
  assertMsg "transfer treasury movement ref mismatch" (movement.movementRef == action.movementRef)
