module NavToken.Test where

import Daml.Script

import NavToken.Types
import NavToken.IssuerRole
import NavToken.Offer
import NavToken.Treasury

testSetup : Script ()
testSetup = script do
  issuer <- allocateParty "Issuer"
  treasury <- allocateParty "Treasury"
  treasuryAdmin <- allocateParty "TreasuryAdmin"
  alice <- allocateParty "Alice"
  operator <- allocateParty "Operator"

  let usdcxRef = TokenRef with
        registry = issuer
        symbol = "USDCx"
        instrumentId = "USDCx-001"

  let navRef = TokenRef with
        registry = issuer
        symbol = "NAV"
        instrumentId = "NAV-001"

  now <- getTime

  let price = Price with
        value = 1.0000
        currency = "USDCx"
        effectiveAt = now
        priceId = "price-001"

  let config = TokenConfig with
        issuer = issuer
        treasury = treasury
        treasuryAdmin = treasuryAdmin
        navToken = navRef
        paymentToken = usdcxRef

  let automation = AutomationPolicy with
        enabled = True
        maxMintUsdcx = 10000.0
        maxBurnTokens = 10000.0
        operators = [operator]

  issuerRoleCid <- submit issuer do
    createCmd IssuerRole with
      config = config
      currentPrice = price
      automation = automation

  treasuryCid <- submit treasury do
    createCmd TreasuryAccount with
      config = config
      usdcxBalance = 0.0

  -- Issuer updates NAV / price
  now2 <- getTime

  let newPrice = Price with
        value = 1.0500
        currency = "USDCx"
        effectiveAt = now2
        priceId = "price-002"

  issuerRoleCid2 <- submit issuer do
    exerciseCmd issuerRoleCid UpdatePrice with
      newPrice = newPrice

  offerCid <- submit issuer do
    exerciseCmd issuerRoleCid2 CreateOffer with
      user = alice

  -- Alice requests mint:
  -- 1,050 USDCx at price 1.05 = 1,000 NAV tokens
  mintReqCid <- submit alice do
    exerciseCmd offerCid RequestMint with
      usdcxAmount = 1050.0
      minTokensOut = 999.0

  -- Issuer and treasury accept mint request and collect USDCx.
  treasuryCid2 <- submitMulti [issuer, treasury] [] do
    exerciseCmd treasuryCid DepositFromMint with
      mintRequestCid = mintReqCid

  -- Treasury admin pulls USDCx for off-chain tokenization handling.
  treasuryCid3 <- submitMulti [treasuryAdmin, treasury] [] do
    exerciseCmd treasuryCid2 PullForOffchainTokenization with
      action = TreasuryAction with
        amount = 100.0
        reason = "off-chain tokenization funding"

  -- Alice requests burn:
  -- 500 NAV at price 1.05 = 525 USDCx
  burnReqCid <- submit alice do
    exerciseCmd offerCid RequestBurn with
      tokenAmount = 500.0
      minUsdcxOut = 524.0

  -- Issuer and treasury accept burn request and return USDCx.
  submitMulti [issuer, treasury] [] do
    exerciseCmd treasuryCid3 ReturnForBurn with
      burnRequestCid = burnReqCid

  return ()
