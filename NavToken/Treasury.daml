module NavToken.Treasury where

import NavToken.Types
import NavToken.MintRequest
import NavToken.BurnRequest

template TreasuryAccount
  with
    config : TokenConfig
    usdcxBalance : Decimal
  where
    signatory config.treasury
    observer config.issuer, config.treasuryAdmin

    ensure usdcxBalance >= 0.0

    choice DepositFromMint : ContractId TreasuryAccount
      with
        mintRequestCid : ContractId MintRequest
      controller config.issuer, config.treasury
      do
        req <- fetch mintRequestCid

        assertMsg "mint request config mismatch"
          (req.config == config)

        exercise mintRequestCid AcceptMintRequest

        create this with
          usdcxBalance = usdcxBalance + req.usdcxAmount

    choice ReturnForBurn : ContractId TreasuryAccount
      with
        burnRequestCid : ContractId BurnRequest
      controller config.issuer, config.treasury
      do
        req <- fetch burnRequestCid

        assertMsg "burn request config mismatch"
          (req.config == config)

        let usdcxOut = req.tokenAmount * req.quotedPrice.value

        assertMsg "insufficient treasury USDCx"
          (usdcxBalance >= usdcxOut)

        exercise burnRequestCid AcceptBurnRequest

        create this with
          usdcxBalance = usdcxBalance - usdcxOut

    choice PullForOffchainTokenization : ContractId TreasuryAccount
      with
        action : TreasuryAction
      controller config.treasuryAdmin, config.treasury
      do
        assertMsg "amount must be positive"
          (action.amount > 0.0)

        assertMsg "insufficient treasury USDCx"
          (usdcxBalance >= action.amount)

        create this with
          usdcxBalance = usdcxBalance - action.amount
