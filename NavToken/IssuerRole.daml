module NavToken.IssuerRole where

import DA.Assert
import NavToken.Types
import NavToken.MintRequest
import NavToken.BurnRequest

template IssuerRole
  with
    config : TokenConfig
    currentPrice : Price
    automation : AutomationPolicy
  where
    signatory config.issuer
    observer config.treasury, automation.operators

    ensure
      currentPrice.value > 0.0
      && currentPrice.currency == config.paymentToken.symbol
      && automation.maxMintUsdcx >= 0.0
      && automation.maxBurnTokens >= 0.0

    choice UpdatePrice : ContractId IssuerRole
      with
        newPrice : Price
      controller config.issuer
      do
        assertMsg "price must be positive"
          (newPrice.value > 0.0)

        assertMsg "price currency must match payment token"
          (newPrice.currency == config.paymentToken.symbol)

        create this with
          currentPrice = newPrice

    nonconsuming choice RequestMint : ContractId MintRequest
      with
        user : Party
        usdcxAmount : Decimal
        minTokensOut : Decimal
      controller user
      do
        assertMsg "USDCx amount must be positive"
          (usdcxAmount > 0.0)

        assertMsg "minTokensOut must be positive"
          (minTokensOut > 0.0)

        let tokensOut = usdcxAmount / currentPrice.value

        assertMsg "slippage check failed"
          (tokensOut >= minTokensOut)

        create MintRequest with
          config
          user
          usdcxAmount
          quotedPrice = currentPrice
          minTokensOut
          automationOperators = automation.operators

    nonconsuming choice RequestBurn : ContractId BurnRequest
      with
        user : Party
        tokenAmount : Decimal
        minUsdcxOut : Decimal
      controller user
      do
        assertMsg "token amount must be positive"
          (tokenAmount > 0.0)

        assertMsg "minUsdcxOut must be positive"
          (minUsdcxOut > 0.0)

        let usdcxOut = tokenAmount * currentPrice.value

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        create BurnRequest with
          config
          user
          tokenAmount
          quotedPrice = currentPrice
          minUsdcxOut
          automationOperators = automation.operators

    nonconsuming choice AutoAcceptMintRequest : ()
      with
        mintRequestCid : ContractId MintRequest
        operator : Party
      controller config.issuer, operator
      do
        assertMsg "automation disabled" automation.enabled

        assertMsg "operator is not authorized"
          (containsParty operator automation.operators)

        req <- fetch mintRequestCid

        assertMsg "mint request config mismatch"
          (req.config == config)

        assertMsg "mint too large for automation"
          (req.usdcxAmount <= automation.maxMintUsdcx)

        exercise mintRequestCid AcceptMintRequest

    nonconsuming choice AutoAcceptBurnRequest : ()
      with
        burnRequestCid : ContractId BurnRequest
        operator : Party
      controller config.issuer, operator
      do
        assertMsg "automation disabled" automation.enabled

        assertMsg "operator is not authorized"
          (containsParty operator automation.operators)

        req <- fetch burnRequestCid

        assertMsg "burn request config mismatch"
          (req.config == config)

        assertMsg "burn too large for automation"
          (req.tokenAmount <= automation.maxBurnTokens)

        exercise burnRequestCid AcceptBurnRequest
