module Zivoe.IssuerRole where

import DA.Time (addRelTime, seconds)

import Zivoe.Types
import Zivoe.Offer

template IssuerRole
  with
    config : TokenConfig
    navPrice : Price
  where
    signatory config.issuer
    observer config.treasury

    ensure
      isValidPaymentPrice config navPrice

    choice UpdatePrice : ContractId IssuerRole
      with
        newPrice : Price
      controller config.issuer
      do
        assertMsg "invalid NAV price"
          (isValidPaymentPrice config newPrice)

        create this with
          navPrice = newPrice

    nonconsuming choice CreateOffer : ContractId TokenOffer
      with
        user : Party
      controller config.issuer
      do
        now <- getTime

        create TokenOffer with
          config
          user
          navPrice
          offerExpiresAt = addRelTime now (seconds 300)

