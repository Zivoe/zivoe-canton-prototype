module Zivoe.BurnRequest where

import Cip56.AllocationV1
import Cip56.MetadataV1
import Zivoe.PCToken
import Cip56.TransferInstructionV1
import Zivoe.Types

template BurnRequest
  with
    config : TokenConfig
    user : Party
    tokenAmount : Decimal
    quotedPrice : Price
    minUsdcxOut : Decimal
    automationOperators : [Party]
  where
    signatory user
    observer config.issuer, config.treasury, automationOperators

    ensure
      tokenAmount > 0.0
      && minUsdcxOut > 0.0
      && quotedPrice.value > 0.0
      && quotedPrice.currency == config.paymentToken.symbol

    choice CancelBurnRequest : ()
      controller user
      do
        pure ()

    choice RejectBurnRequest : ()
      controller config.issuer
      do
        pure ()

    choice AcceptBurnRequest : ()
      controller config.issuer
      do
        let usdcxOut = tokenAmount * quotedPrice.value

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        -- TODO CIP-56:
        -- 1. Burn or redeem user's NAV token.
        -- 2. Transfer USDCx from config.treasury to user.

        pure ()

    choice AcceptBurnRequestWithPCTokenAndUsdcxTransfer : [ContractId PCToken]
      with
        pcTokenCid : ContractId PCToken
        usdcxTransferInstructionCid : ContractId TransferInstruction
        extraArgs : ExtraArgs
      controller config.issuer, user
      do
        let usdcxOut = tokenAmount * quotedPrice.value

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        pcToken <- fetch pcTokenCid

        assertMsg "PCToken owner mismatch"
          (pcToken.owner == user)

        assertMsg "PCToken instrument mismatch"
          (pcToken.instrumentId == tokenRefToInstrumentId config.navToken)

        usdcxTransferInstruction <- fetch usdcxTransferInstructionCid
        let transfer = (view usdcxTransferInstruction).transfer

        assertMsg "USDCx transfer sender mismatch"
          (transfer.sender == config.treasury)

        assertMsg "USDCx transfer receiver mismatch"
          (transfer.receiver == user)

        assertMsg "USDCx transfer amount mismatch"
          (transfer.amount == usdcxOut)

        assertMsg "USDCx transfer instrument mismatch"
          (transfer.instrumentId == tokenRefToInstrumentId config.paymentToken)

        changeCids <- exercise pcTokenCid BurnAmount with
          burnAmount = tokenAmount

        transferResult <- exercise usdcxTransferInstructionCid TransferInstruction_Accept with
          extraArgs

        case transferResult.output of
          TransferInstructionResult_Completed with receiverHoldingCids -> do
            assertMsg "USDCx transfer produced no user holding"
              (not (null receiverHoldingCids))
          _ -> abort "USDCx transfer did not complete"

        pure changeCids

    choice AcceptBurnRequestWithPCTokenAndUsdcxAllocation : [ContractId PCToken]
      with
        pcTokenCid : ContractId PCToken
        usdcxAllocationCid : ContractId Allocation
        extraArgs : ExtraArgs
      controller config.issuer, config.treasury, user
      do
        let usdcxOut = tokenAmount * quotedPrice.value

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        pcToken <- fetch pcTokenCid

        assertMsg "PCToken owner mismatch"
          (pcToken.owner == user)

        assertMsg "PCToken instrument mismatch"
          (pcToken.instrumentId == tokenRefToInstrumentId config.navToken)

        usdcxAllocation <- fetch usdcxAllocationCid
        let allocation = (view usdcxAllocation).allocation
        let transferLeg = allocation.transferLeg

        assertMsg "USDCx allocation sender mismatch"
          (transferLeg.sender == config.treasury)

        assertMsg "USDCx allocation receiver mismatch"
          (transferLeg.receiver == user)

        assertMsg "USDCx allocation executor mismatch"
          (allocation.settlement.executor == config.issuer)

        assertMsg "USDCx allocation amount mismatch"
          (transferLeg.amount == usdcxOut)

        assertMsg "USDCx allocation instrument mismatch"
          (transferLeg.instrumentId == tokenRefToInstrumentId config.paymentToken)

        changeCids <- exercise pcTokenCid BurnAmount with
          burnAmount = tokenAmount

        allocationResult <- exercise usdcxAllocationCid Allocation_ExecuteTransfer with
          extraArgs

        assertMsg "USDCx allocation produced no user holding"
          (not (null allocationResult.receiverHoldingCids))

        pure changeCids
