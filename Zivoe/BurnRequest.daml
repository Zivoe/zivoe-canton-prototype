module Zivoe.BurnRequest where

import Cip56.AllocationV1
import Cip56.HoldingV1
import Cip56.MetadataV1
import Cip56.TransferInstructionV1

import Zivoe.PCToken
import Zivoe.Types

sumValidatedHoldings : Text -> Party -> InstrumentId -> [ContractId Holding] -> Update Decimal
sumValidatedHoldings label expectedOwner expectedInstrument holdingCids =
  case holdingCids of
    [] -> pure 0.0
    holdingCid :: rest -> do
      holding <- fetch holdingCid
      let holdingView = view holding

      assertMsg (label <> " owner mismatch")
        (holdingView.owner == expectedOwner)

      assertMsg (label <> " instrument mismatch")
        (holdingView.instrumentId == expectedInstrument)

      restAmount <- sumValidatedHoldings label expectedOwner expectedInstrument rest
      pure (holdingView.amount + restAmount)

validateReceiverHoldings : Text -> Party -> InstrumentId -> Decimal -> [ContractId Holding] -> Update ()
validateReceiverHoldings label expectedOwner expectedInstrument expectedAmount holdingCids = do
  assertMsg (label <> " produced no receiver holding")
    (not (null holdingCids))

  totalAmount <- sumValidatedHoldings label expectedOwner expectedInstrument holdingCids

  assertMsg (label <> " amount mismatch")
    (totalAmount == expectedAmount)

template BurnRequest
  with
    config : TokenConfig
    user : Party
    tokenAmount : Decimal
    quotedPrice : Price
    minUsdcxOut : Decimal
    requestRef : Text
    requestedAt : Time
    acceptBefore : Time
  where
    signatory user
    observer config.issuer, config.treasury

    ensure
      tokenAmount > 0.0
      && minUsdcxOut > 0.0
      && isValidPaymentPrice config quotedPrice
      && requestRef /= ""
      && quotedPrice.effectiveAt <= requestedAt
      && requestedAt < acceptBefore

    choice CancelBurnRequest : ()
      controller user
      do
        pure ()

    choice RejectBurnRequest : ()
      controller config.issuer
      do
        pure ()

    choice AcceptBurnRequest : [ContractId PCToken]
      with
        pcTokenCid : ContractId PCToken
        usdcxTransferInstructionCid : ContractId TransferInstruction
        extraArgs : ExtraArgs
      controller config.issuer, user
      do
        now <- getTime
        let usdcxOut = usdcxOutForBurn tokenAmount quotedPrice

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        assertMsg "burn request expired"
          (acceptBefore > now)

        pcToken <- fetch pcTokenCid

        assertMsg "PCToken owner mismatch"
          (pcToken.owner == user)

        assertMsg "PCToken issuer mismatch"
          (pcToken.issuer == config.issuer)

        assertMsg "PCToken instrument mismatch"
          (pcToken.instrumentId == tokenRefToInstrumentId config.navToken)

        usdcxTransferInstruction <- fetch usdcxTransferInstructionCid
        let transfer = (view usdcxTransferInstruction).transfer

        assertMsg "USDCx transfer sender mismatch"
          (transfer.sender == config.treasury)

        assertMsg "USDCx transfer receiver mismatch"
          (transfer.receiver == user)

        assertMsg "USDCx transfer amount mismatch"
          (transfer.amount == usdcxOut)

        assertMsg "USDCx transfer instrument mismatch"
          (transfer.instrumentId == tokenRefToInstrumentId config.paymentToken)

        assertMsg "USDCx transfer request ref mismatch"
          (metadataContains requestRefMetadataKey requestRef transfer.meta)

        assertMsg "USDCx transfer expired"
          (transfer.executeBefore > now)

        changeCids <- exercise pcTokenCid BurnAmount with
          burnAmount = tokenAmount

        transferResult <- exercise usdcxTransferInstructionCid TransferInstruction_Accept with
          extraArgs

        case transferResult.output of
          TransferInstructionResult_Completed with receiverHoldingCids -> do
            validateReceiverHoldings "USDCx transfer" user (tokenRefToInstrumentId config.paymentToken) usdcxOut receiverHoldingCids
          _ -> abort "USDCx transfer did not complete"

        pure changeCids

    choice AcceptBurnRequestWithPCTokenAndUsdcxAllocation : [ContractId PCToken]
      with
        pcTokenCid : ContractId PCToken
        usdcxAllocationCid : ContractId Allocation
        extraArgs : ExtraArgs
      controller config.issuer, config.treasury, user
      do
        now <- getTime
        let usdcxOut = usdcxOutForBurn tokenAmount quotedPrice

        assertMsg "slippage check failed"
          (usdcxOut >= minUsdcxOut)

        assertMsg "burn request expired"
          (acceptBefore > now)

        pcToken <- fetch pcTokenCid

        assertMsg "PCToken owner mismatch"
          (pcToken.owner == user)

        assertMsg "PCToken issuer mismatch"
          (pcToken.issuer == config.issuer)

        assertMsg "PCToken instrument mismatch"
          (pcToken.instrumentId == tokenRefToInstrumentId config.navToken)

        usdcxAllocation <- fetch usdcxAllocationCid
        let allocation = (view usdcxAllocation).allocation
        let transferLeg = allocation.transferLeg

        assertMsg "USDCx allocation sender mismatch"
          (transferLeg.sender == config.treasury)

        assertMsg "USDCx allocation receiver mismatch"
          (transferLeg.receiver == user)

        assertMsg "USDCx allocation executor mismatch"
          (allocation.settlement.executor == config.issuer)

        assertMsg "USDCx allocation settlement ref mismatch"
          (allocation.settlement.settlementRef.id == requestRef)

        assertMsg "USDCx allocation transfer leg id mismatch"
          (allocation.transferLegId == "usdcx-leg")

        assertMsg "USDCx allocation requestedAt is before request"
          (allocation.settlement.requestedAt >= requestedAt)

        assertMsg "USDCx allocation requestedAt is in the future"
          (allocation.settlement.requestedAt <= now)

        assertMsg "USDCx allocation deadline invalid"
          (allocation.settlement.allocateBefore <= allocation.settlement.settleBefore)

        assertMsg "USDCx allocation amount mismatch"
          (transferLeg.amount == usdcxOut)

        assertMsg "USDCx allocation instrument mismatch"
          (transferLeg.instrumentId == tokenRefToInstrumentId config.paymentToken)

        assertMsg "USDCx allocation settlement expired"
          (allocation.settlement.settleBefore > now)

        changeCids <- exercise pcTokenCid BurnAmount with
          burnAmount = tokenAmount

        allocationResult <- exercise usdcxAllocationCid Allocation_ExecuteTransfer with
          extraArgs

        validateReceiverHoldings "USDCx allocation" user (tokenRefToInstrumentId config.paymentToken) usdcxOut allocationResult.receiverHoldingCids

        pure changeCids
